// Prisma schema — define your database models here.
//
// The models are yours to design. After adding or changing a model, run:
//   yarn prisma:migrate
// Prisma 7 note: the connection URL lives in `prisma.config.ts`, not here.
// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// TODO: add your models below. The capstone requires more than one table with
// a relationship between them.

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  courses Course[]
}

model Course {
  id         String   @id @default(uuid())
  campus String
  department String
  courseCode String
  courseName String
  credits String
  grade String?
  user_id String
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@unique([user_id, campus, courseCode])
  createdAt  DateTime @default(now())
  // Many-to-one: each Course belongs to the User who saved/planned it.
}

model Transfer {
  id   String @id @default(uuid())
  name String @unique
}