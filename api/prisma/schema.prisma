// Prisma schema — define your database models here.
//
// The models are yours to design. After adding or changing a model, run:
//   yarn prisma:migrate
// Prisma 7 note: the connection URL lives in `prisma.config.ts`, not here.
// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// TODO: add your models below. The capstone requires more than one table with
// a relationship between them.

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

//
enum TransferType {
  DIRECT
  ELECTIVE
  NO_CREDIT
}

model College {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  fromRules TransferCredit[] @relation("FromCollege")
  toRules   TransferCredit[] @relation("ToCollege")
}

model TransferCredit {
  id             String       @id @default(uuid())
  fromCollegeId  String
  fromCollege    College      @relation("FromCollege", fields: [fromCollegeId], references: [id])
  fromCourseCode String
  fromCourseName String
  fromCredits    Float

  toCollegeId    String
  toCollege      College      @relation("ToCollege", fields: [toCollegeId], references: [id])
  toCourseCode   String?      // nullable — no specific match for ELECTIVE/NO_CREDIT
  toCourseName   String?
  toCredits      Float

  transferType   TransferType @default(DIRECT)
  notes          String?
  createdAt      DateTime     @default(now())

  @@unique([fromCollegeId, fromCourseCode, toCollegeId])
  @@index([fromCollegeId, fromCourseCode])
  @@index([toCollegeId])
}