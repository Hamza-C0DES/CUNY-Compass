# PostgreSQL connection string for Prisma.
# Copy this file to `.env` and set your real database URL.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cuny_compass?schema=public"

# Port the API listens on.
PORT=3000

# Secret used to sign/verify JWTs. Use a long random string, and never commit
# the real value — generate one with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
